# 明镜 CLI 配置模板 —— 复制为 .env 并填入真实值
# 注意：.env 已被 .gitignore 忽略，绝不要提交真实 key。

# LLM API Key（必填，从 https://open.bigmodel.cn 或 https://platform.deepseek.com 获取）
MINGTIAN_API_KEY=

# 服务商：glm | deepseek | qwen（默认 glm）
MINGTIAN_PROVIDER=glm

# 模型名（留空则用服务商默认，见 lib/llm/providers.dart）
MINGTIAN_MODEL=

# 可选：覆盖默认 baseURL（一般不需要）
# MINGTIAN_BASE_URL=

# 可选：RAG 检索 top-K（默认 4）
# MINGTIAN_TOP_K=4

# 可选：对话历史保留轮数（默认 6）
# MINGTIAN_HISTORY=6
