  },
  {
    "id": "zhuan-yi-007",
    "原文": "死是一件不必急于求成的事，死是一个必然会降临的节日。",
    "出处": "史铁生《我与地坛》",
    "白话解析": "既然死是必然，活就是不必着急的事。把'怕来不及'的焦虑放下，慢慢活，认真活。",
    "适用场景": ["意义与方向危机", "焦虑与精神内耗"],
    "禁用场景": ["有自伤/自杀倾向者——此句可能被误读，须先走危机转介流程"],
    "关联声部": "zhuan-yi"
  },
  {
    "id": "zhuan-yi-008",
    "原文": "生命的意义本不在向外的寻取，而在向内的建立。",
    "出处": "史铁生《病隙碎笔》",
    "白话解析": "向外追意义（升职、买房、别人的认可）会累且空，向内的建立（我是谁、我要成为什么样的人）才扎实。",
    "适用场景": ["意义与方向危机"],
    "禁用场景": [],
    "关联声部": "zhuan-yi"
  },
  {
    "id": "zhuan-yi-009",
    "原文": "横逆困穷是锻炼豪杰的一副炉锤。",
    "出处": "《菜根谭》",
    "白话解析": "困难是锻炼英雄的熔炉。别把困难当灾难——它是来锻造你的。",
    "适用场景": ["工作倦怠与异化", "意义与方向危机"],
    "禁用场景": [],
    "关联声部": "zhuan-yi"
  },
  {
    "id": "zhuan-yi-010",
    "原文": "醲肥辛甘非真味，真味只是淡。",
    "出处": "《菜根谭》",
    "白话解析": "浓烈肥美不是真味道，真正的味道是清淡。生活的真味不在刺激，在平淡中的满足。",
    "适用场景": ["欲望与物质匮乏感"],
    "禁用场景": [],
    "关联声部": "zhuan-yi"
  },
  {
    "id": "zhuan-yi-011",
    "原文": "静中观心，真妄毕见。",
    "出处": "《菜根谭》",
    "白话解析": "安静时观察自己的心，真假都会显现。别总忙着做事——偶尔停下来，看看自己内心到底在想什么。",
    "适用场景": ["焦虑与精神内耗", "意义与方向危机"],
    "禁用场景": [],
    "关联声部": "zhuan-yi"
  },
  {
    "id": "zhuan-yi-012",
    "原文": "横向关系：不纵向比较。",
    "出处": "《被讨厌的勇气》（阿德勒概念通俗版）",
    "白话解析": "别跟人比高低——建立横向关系，互相尊重，不是互相竞争。比来比去，只会两败俱伤。",
    "适用场景": ["人际与情感困扰", "欲望与物质匮乏感"],
    "禁用场景": [],
    "关联声部": "zhuan-yi"
  },
  {
    "id": "zhuan-yi-013",
    "原文": "接纳自我。",
    "出处": "《被讨厌的勇气》核心概念",
    "白话解析": "不是变成更好的自己，是接纳现在的自己。改变从接纳开始——不接纳自己的人，改变不了。",
    "适用场景": ["焦虑与精神内耗", "意义与方向危机"],
    "禁用场景": [],
    "关联声部": "zhuan-yi"
  },
  {
    "id": "zhuan-yi-014",
    "原文": "贡献感。",
    "出处": "《被讨厌的勇气》核心概念",
    "白话解析": "觉得自己'有价值'的方式是感受到自己对别人的贡献。不是被认可，是主动贡献——这比被认可更踏实。",
