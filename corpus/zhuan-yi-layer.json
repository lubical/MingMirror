  },
  {
    "id": "zhuan-yi-003",
    "原文": "课题分离：我的课题和别人的课题，要分开。",
    "出处": "《被讨厌的勇气》核心概念（阿德勒心理学通俗版）",
    "白话解析": "'他怎么看我'是他的课题，'我怎么做'才是我的课题。把别人的课题还给别人，你的负担会轻一大半。",
    "适用场景": ["人际与情感困扰", "焦虑与精神内耗"],
    "禁用场景": [],
    "关联声部": "zhuan-yi"
  },
  {
    "id": "zhuan-yi-004",
    "原文": "自由，就是不再寻求认可。",
    "出处": "《被讨厌的勇气》（大意）",
    "白话解析": "一直讨好别人，是因为把'被认可'当成了必需品。自由的第一步，是允许一部分人讨厌你。",
    "适用场景": ["人际与情感困扰"],
    "禁用场景": ["把'不再寻求认可'误用为孤僻、拒绝一切关系——自由不等于切断连接"],
    "关联声部": "zhuan-yi"
  },
  {
    "id": "zhuan-yi-005",
    "原文": "你痛苦的原因，不在过去，而在你对过去的解释。",
    "出处": "《被讨厌的勇气》（阿德勒观点通俗版）",
    "白话解析": "不是过去决定了你，是你现在赋予过去的解释在起作用。解释权在你手里——换一种解释，就换了一种活法。",
    "适用场景": ["焦虑与精神内耗", "意义与方向危机"],
    "禁用场景": [],
    "关联声部": "zhuan-yi"
  },
  {
    "id": "zhuan-yi-006",
    "原文": "当下是唯一真实的力量点。",
    "出处": "《当下的力量》核心概念（大意）",
    "白话解析": "你的力量只存在于当下这一刻。'如果当时''万一以后'都是幻影——回到此刻正在做的事上。",
    "适用场景": ["焦虑与精神内耗"],
    "禁用场景": [],
